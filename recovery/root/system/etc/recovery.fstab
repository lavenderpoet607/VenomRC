system_ext /system_ext erofs ro wait,logical,first_stage_mount
odm /odm ext4 ro,barrier=1 wait,logical,first_stage_mount
odm /odm erofs ro wait,logical,first_stage_mount

/dev/block/by-name/boot /boot emmc defaults defaults
/dev/block/by-name/recovery /recovery emmc defaults defaults
/dev/block/by-name/metadata /metadata ext4 noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678,inlinecrypt wait,check,formattable,quota,latemount,reservedsize=128M,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0
/dev/block/by-name/cache /cache ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable
/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/by-name/dtbo /dtbo emmc defaults defaults
/dev/block/by-name/vbmeta /vbmeta emmc defaults defaults
/dev/block/by-name/vbmeta_system /vbmeta_system emmc defaults defaults
/dev/block/by-name/sec_efs /efs ext4 noatime,nosuid,nodev wait,check
/dev/block/by-name/nvram /nvram emmc defaults defaults
/dev/block/by-name/nvdata /nvdata ext4 noatime,nosuid,nodev wait,check
/dev/block/by-name/protect1 /protect_f ext4 noatime,nosuid,nodev wait,check
/dev/block/by-name/protect2 /protect_s ext4 noatime,nosuid,nodev wait,check
/dev/block/mmcblk1p1 /external_sd auto defaults defaults
/dev/block/sda1 /usb_otg auto defaults defaults
